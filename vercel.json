{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "movies.json",
          "series_enriched.json",
          "show_meta_cache.json",
          "stream_cache.json",
          "translation_cache.json",
          "scene_english.js",
          "public/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
